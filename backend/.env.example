# 복사해서 .env 로 사용: cp .env.example .env
DEBUG=true
DATABASE_URL=sqlite:///./bangguseok.db
SEED_ON_STARTUP=true


# Gemini API (https://aistudio.google.com/apikey 에서 무료 발급)
GEMINI_API_KEY=
LLM_MODEL=gemini-3.8-flash
# AI 응답 속도: minimal/low/medium/high (낮을수록 빠름), 제한 시간(초)
LLM_THINKING_LEVEL=low
LLM_TIMEOUT_SECONDS=30

# AI 사진 인식 · 레시피 생성 (true 면 Gemini 호출 없이 가짜 결과 반환)
AI_MOCK=true

# AI 레시피 실시간 생성 (추천 결과가 AI_RECIPE_MIN_RESULTS 개보다 적으면 Gemini가 생성)
AI_RECIPE_ENABLED=true
AI_RECIPE_MIN_RESULTS=3
AI_RECIPE_COUNT=2

# 푸시 알림 스케줄러
SCHEDULER_ENABLED=false
EXPIRY_ALERT_HOUR=9
# true 면 Expo Push 로 실제 발송 (false 면 서버 로그에만 찍힘)
PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=
