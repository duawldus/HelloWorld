# 복사해서 .env 로 사용: cp .env.example .env
DEBUG=true
DATABASE_URL=sqlite:///./bangguseok.db
SEED_ON_STARTUP=true


# Gemini API (https://aistudio.google.com/apikey 에서 무료 발급)
GEMINI_API_KEY=
LLM_MODEL=gemini-3.8-flash

# AI 사진 인식 · 레시피 생성 (true 면 Gemini 호출 없이 가짜 결과 반환)
AI_MOCK=true

# AI 레시피 실시간 생성 (추천 결과가 AI_RECIPE_MIN_RESULTS 개보다 적으면 Gemini가 생성)
AI_RECIPE_ENABLED=true
AI_RECIPE_MIN_RESULTS=3
AI_RECIPE_COUNT=2

# 푸시 알림 스케줄러
SCHEDULER_ENABLED=false
EXPIRY_ALERT_HOUR=9
