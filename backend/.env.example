# 복사해서 .env 로 사용: cp .env.example .env
DEBUG=true
DATABASE_URL=sqlite:///./bangguseok.db
SEED_ON_STARTUP=true

JWT_SECRET=change-me-to-a-long-random-string-32chars+
JWT_EXPIRE_DAYS=30

# Claude API (https://console.anthropic.com 에서 발급)
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5

# AI 사진 인식 (true 면 Claude 호출 없이 가짜 결과 반환)
AI_MOCK=true

# 푸시 알림 스케줄러
SCHEDULER_ENABLED=false
EXPIRY_ALERT_HOUR=9
